# iyzico — Vercel Production'a ekle (isimler tam böyle olmalı):
IYZI_API_KEY=sandbox-your-api-key
IYZI_SECRET_KEY=sandbox-your-secret-key
IYZI_BASE_URL=https://sandbox-api.iyzipay.com
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Canlıda:
# IYZI_BASE_URL=https://api.iyzipay.com
# NEXT_PUBLIC_BASE_URL=https://www.fullbiteburger.com
# Alternatif tek satır: IYZI_CREDENTIALS=apiKey|secretKey|https://api.iyzipay.com
# Env ekledikten sonra Vercel'de Redeploy şart.

# Yönetim paneli (/yonetim) — Vercel Production'a ekle:
ADMIN_EMAIL=admin@fullbiteburger.com
ADMIN_PASSWORD=degistir-bu-sifreyi
ADMIN_SESSION_SECRET=uzun-rastgele-bir-metin-yazin

# Alternatif: birden fazla hesap (email:sifre,email2:sifre2)
# ADMIN_USERS=admin@fullbiteburger.com:sifre1,mutfak@fullbiteburger.com:sifre2

# Yönetim kazanç hesabı (KDV dahil fiyatlar, iyzico komisyonu brüt üzerinden)
# ADMIN_VAT_RATE=10
# ADMIN_COST_RATE=40
# ADMIN_IYZICO_COMMISSION_RATE=2.99
# ADMIN_IYZICO_FIXED_FEE=0.25
